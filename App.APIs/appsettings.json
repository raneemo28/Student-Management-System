{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Caching": {
    "DefaultTtlSeconds": 30,
    "UseDistributedCache": false,
    "TtlOverrides": {
      "StudentRead": { "Seconds": 30 },
      "InstructorRead": { "Seconds": 60 },
      "EmployeeRead": { "Seconds": 60 },
      "CourseRead": { "Seconds": 60 },
      "CourseStudentRead": { "Seconds": 30 },
      "CourseContentRead": { "Seconds": 120 },
      "AdvertisementRead": { "Seconds": 300 },
      "HomeworkRead": { "Seconds": 15 },
      "HomeworkSubmissionRead": { "Seconds": 15 },
      "HomeworkSolutionRead": { "Seconds": 30 },
      "HomeworkQuestionMarkRead": { "Seconds": 10 }
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "studentmgmt:"
  },
  "ConnectionStrings": {
    "BusinessDbConnection": "Server=localhost;Database=StudentDomainDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "IdentityDbConnection": "Server=localhost;Database=StudentAuthDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "ReadDbConnection": "Server=localhost;Database=StudentReadDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "RabbitMQ": "amqp://guest:guest@rabbitmq:5672"
  },
  "RabbitMQ": {
    "QueueName": "logs"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForJwtTokenGeneration12345!",
    "Issuer": "StudentApp",
    "Audience": "StudentAppUsers",
    "ExpiryInHours": "2"
  },
  "FileStorage": {
    "Path": "Storage",
    "BaseUrl": "/storage/"
  },
  "AllowedHosts": "*"
}
